# OpenRouter secret; required only for asking questions, never for indexing.
OPENROUTER_API_KEY=your_openrouter_key_here

# Both rewriting and answering use this explicit free model. Paid models are blocked.
# Verified 2026-10-29: qwen/qwen3.8-27b:free has no endpoints; no free Qwen is listed.
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Public embedding model downloaded once, then run locally on CPU. No HF token needed.
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional writable cache; Docker defaults to /home/user/.cache/huggingface.
# HF_HOME=/path/to/model-cache

# Local folder used for notes.
NOTES_DIR=notes

# Chroma index location.
# Use:
# - ./chroma_db locally
# - /data/chroma_db only when writable persistent storage is mounted at /data.
CHROMA_DIR=./chroma_db
# New collection for migration: preserves legacy vectors in the `notes` collection.
# Rebuild this collection before querying; see README.md.
CHROMA_COLLECTION=notes

# Public GitHub repo contents endpoint used by `sync-notes`.
NOTES_REPO_CONTENTS_URL=https://api.github.com/repos/ditek/Notes/contents

# Keep false for public deployments.
ENABLE_SIDEBAR_CONTROLS=false
DEFAULT_RETRIEVAL_K=2

# Optional: only needed for non-interactive Hugging Face deploys.
# HF_SPACE_REMOTE_URL=https://huggingface.co/spaces/YOUR_NAMESPACE/YOUR_SPACE
# HF_DEPLOY_USERNAME=YOUR_HF_USERNAME
# The token must have "Write access" permission to the Space repository.
# HF_DEPLOY_TOKEN=hf_your_write_token

# FastAPI settings
API_ALLOWED_ORIGINS=*
# API_ADMIN_TOKEN=
